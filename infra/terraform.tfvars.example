# Copy to terraform.tfvars and fill in your values. Do not commit terraform.tfvars.
subscription_id      = "00000000-0000-0000-0000-000000000000"
resource_group_name  = "<your-resource-group>"
location             = "uksouth" # <permitted-location>; omit to use the resource group's location
storage_account_name = "productappstoragename"

# Path to the `npm run build` output; set to "" to skip uploading
dist_path = "../dist"

# Existing backend Function App to allow CORS from the site; set to "" to skip
function_app_name = "<your-backend-products-func>"
